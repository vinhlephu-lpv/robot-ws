# ==============================================================================
# 📡 CẤU HÌNH THÔNG TIN MẠNG (HOTSPOT ĐIỆN THOẠI & MẠNG TRƯỜNG)
# ==============================================================================
# File này chứa các thông số kết nối giữa PC và Raspberry Pi.
# Bạn chỉ cần sửa các giá trị trong dấu ngoặc kép "" dưới đây, lưu file lại
# và gõ lệnh 'reload' (hoặc mở terminal mới) là các lệnh sẽ tự động áp dụng.

# 1. Tên Wi-Fi mạng trường (mặc định là CTU)
export WIFI_TRUONG="CTU"

# 2. Tên Wi-Fi Hotspot do điện thoại của bạn phát ra
export WIFI_HOTSPOT="OPPO"

# 3. Mật khẩu Wi-Fi Hotspot điện thoại
export WIFI_HOTSPOT_PASS="tumottoinam"

# 4. Username tài khoản trên Raspberry Pi (dùng để SSH, truyền file)
export PI_USER="bao"

# 5. Hostname của Raspberry Pi (kiểm tra bằng cách gõ `hostname` trên Pi)
# Mặc định thường là "bao" hoặc "raspberrypi" (dùng để tìm qua bao.local)
export PI_HOSTNAME="bao-desktop"

# 6. IP mạng trường hiện tại của Pi (dự phòng khi ở trường)
export PI_STATIC_IP="10.10.178.200"
