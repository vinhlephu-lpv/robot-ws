<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_sensor_test</name>
  <version>1.0.0</version>
  <description>Dedicated package for testing real Camera and LiDAR sensors on PC/Raspberry Pi</description>
  <maintainer email="user@todo.todo">vinh</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rviz2</depend>

  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
