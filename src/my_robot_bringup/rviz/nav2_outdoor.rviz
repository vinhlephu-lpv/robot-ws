Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Color: 60; 60; 60
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description

    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR Scan
      Enabled: true
      Value: true
      Topic:
        Value: /scan
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Style: Points
      Min Intensity: 0
      Max Intensity: 4096

    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Value: true
      Topic:
        Value: /global_costmap/costmap
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: true

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Value: true
      Topic:
        Value: /local_costmap/costmap
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false

    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan
      Enabled: true
      Value: true
      Topic:
        Value: /plan
      Color: 255; 0; 255
      Line Style: Lines
      Width: 0.05
      Alpha: 1.0

    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Value: true
      Topic:
        Value: /local_plan
      Color: 0; 255; 255
      Line Style: Lines
      Width: 0.03
      Alpha: 0.8

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_footprint:
          Value: false
        odom:
          Value: false
        laser_frame:
          Value: false

  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: nav2_rviz_plugins/GoalTool
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Near: 0.01
      Scale: 30
      X: 0
      Y: 0
      Angle: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 100
  Y: 100
